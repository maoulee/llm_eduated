# Local / vLLM model paths
LOCAL_MODEL_PATH=/path/to/qwen3-model
LOCAL_TENSOR_PARALLEL_SIZE=2
LOCAL_THINKING_CONTROL_METHOD=prompt

# vLLM online OpenAI-compatible server
# Start server, for example:
#   vllm serve Qwen/Qwen3-32B --port 8000
# Latest vLLM chat batch endpoint used by this project:
#   POST /v1/chat/completions/batch
# with payload messages=[[...conversation1...], [...conversation2...]].
VLLM_API_BASE=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=/path/to/qwen3-model-or-served-model-name
VLLM_API_PROTOCOL=vllm_chat_batch
VLLM_BATCH_SIZE=16
VLLM_PROMPT_TEMPLATE_STYLE=qwen
# Thinking control options:
#   chat_template_kwargs: send {"chat_template_kwargs": {"enable_thinking": true/false}}
#   prompt: append /no_think when disabled
#   none: do not control thinking
#   param: send provider-specific thinking param
VLLM_THINKING_CONTROL_METHOD=chat_template_kwargs
VLLM_SUPPORTS_RESPONSE_FORMAT=true
VLLM_DEFAULT_MAX_TOKENS=4096

# GLM 5.1 OpenAI-compatible API
# Do not commit real keys. Set this in your local .env or environment.
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4/
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-5.1
GLM_BATCH_SIZE=4
GLM_THINKING_CONTROL_METHOD=none
GLM_SUPPORTS_RESPONSE_FORMAT=true
GLM_DEFAULT_MAX_TOKENS=4096

# Other optional providers
GPTOSS_API_BASE=http://localhost:8000/v1
GPTOSS_API_KEY=ollama
GPTOSS_MODEL=gpt-oss:20b
GPTOSS_API_PROTOCOL=openai_chat
GPTOSS_THINKING_CONTROL_METHOD=prompt

QWEN3_API_BASE=http://localhost:8000/v1
QWEN3_API_KEY=EMPTY
QWEN3_MODEL=/path/to/qwen3-model
QWEN3_API_PROTOCOL=openai_chat
QWEN3_THINKING_CONTROL_METHOD=prompt

# Embedding model
EMBEDDING_MODEL_PATH=/path/to/bge-m3
